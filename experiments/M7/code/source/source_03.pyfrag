    return torch.device("cpu")


def covariance(x: Any) -> Any:
    """Population covariance with rows=observations; safe for a single row."""
    import numpy as np
    x = np.asarray(x, dtype=np.float64)
    if x.ndim == 1:
        x = x[:, None]
    if len(x) < 2:
        return np.zeros((x.shape[1], x.shape[1]), dtype=np.float64)
    xc = x - x.mean(axis=0, keepdims=True)
    return (xc.T @ xc) / len(xc)


def temporal_covariances(noise: Any, max_lag: int) -> Any:
    import numpy as np
    noise = np.asarray(noise, dtype=np.float64)
    centered = noise - noise.mean(axis=0, keepdims=True)
    out = []
    for lag in range(max_lag + 1):
        left, right = centered[lag:], centered[:len(centered) - lag]
        out.append((left.T @ right) / max(1, len(left)))
    return np.stack(out)


def distribution_moments(x: Any) -> Dict[str, float]:
    import numpy as np
    x = np.asarray(x, dtype=np.float64).ravel()
    mu = float(x.mean()); sd = float(x.std())
    z = (x - mu) / max(sd, 1e-12)
    return {"mean": mu, "variance": float(x.var()), "skewness": float((z ** 3).mean()),
            "excess_kurtosis": float((z ** 4).mean() - 3.0)}


def empirical_wasserstein_1d(x: Any, y: Any) -> float:
    """Dependency-free equal-weight 1D Wasserstein distance using quantiles."""
    import numpy as np
    x = np.sort(np.asarray(x, dtype=np.float64).ravel())
    y = np.sort(np.asarray(y, dtype=np.float64).ravel())
    if len(x) == len(y):
        return float(np.mean(np.abs(x - y)))
    grid = np.linspace(0.0, 1.0, max(len(x), len(y)))
    return float(np.mean(np.abs(np.quantile(x, grid), np.quantile(y, grid))))


def exact_row_permutation(real: Any, shuffled: Any) -> bool:
    """Exact multivariate multiset equality without constructing covariance."""
    import numpy as np
    def row_multiset(a: Any) -> Any:
        a = np.ascontiguousarray(a)
        row_bytes = a.view(np.dtype((np.void, a.dtype.itemsize * a.shape[1]))).ravel()
        return np.sort(row_bytes)
    return bool(np.array_equal(row_multiset(real), row_multiset(shuffled)))


def ablation_checks(real: Any, shuffled: Any, iid: Any, lags: int) -> Dict[str, Any]:
    """Checks required before comparing outcomes.  No test decides the hypothesis."""
    import numpy as np
    real = np.asarray(real); shuffled = np.asarray(shuffled); iid = np.asarray(iid)
    cov_r, cov_s, cov_i = covariance(real), covariance(shuffled), covariance(iid)
    tc_r, tc_s, tc_i = temporal_covariances(real, lags), temporal_covariances(shuffled, lags), temporal_covariances(iid, lags)
    exact_permutation = exact_row_permutation(real, shuffled)
    return {
        "A_B_exact_same_samples_per_coordinate": exact_permutation,
        "A_B_mean_max_abs_diff": float(np.max(np.abs(real.mean(0) - shuffled.mean(0)))),
        "A_B_cov_fro_diff": float(np.linalg.norm(cov_r - cov_s, ord="fro")),
        "A_C_cov_rel_fro_diff": float(np.linalg.norm(cov_r - cov_i, ord="fro") / max(np.linalg.norm(cov_r, ord="fro"), 1e-12)),
        "A_B_wasserstein_flat": empirical_wasserstein_1d(real.ravel(), shuffled.ravel()),
        "A_C_wasserstein_flat": empirical_wasserstein_1d(real.ravel(), iid.ravel()),
        "A_moments": distribution_moments(real), "B_moments": distribution_moments(shuffled), "C_moments": distribution_moments(iid),
        "offdiag_temporal_fro_A": float(np.linalg.norm(tc_r[1:])),
        "offdiag_temporal_fro_B": float(np.linalg.norm(tc_s[1:])),
        "offdiag_temporal_fro_C": float(np.linalg.norm(tc_i[1:])),
        "temporal_covariance_A": tc_r, "temporal_covariance_B": tc_s, "temporal_covariance_C": tc_i,
    }


def neural_ablation_checks(real: Any, shuffled: Any, iid: Any, projection: Any, lags: int) -> Dict[str, Any]:
    """High-dimensional intervention audit without P-by-P covariance matrices.

    Exact A/B row equality proves preservation of every empirical marginal and
    same-time covariance entry. Empirical A/C and temporal diagnostics are
    evaluated in a frozen projection selected independently of outcomes.
    """
    import numpy as np
    real = np.asarray(real); shuffled = np.asarray(shuffled); iid = np.asarray(iid)
    exact_permutation = exact_row_permutation(real, shuffled)
    zr = np.asarray(real @ projection.T, dtype=np.float64)
    zs = np.asarray(shuffled @ projection.T, dtype=np.float64)
    zi = np.asarray(iid @ projection.T, dtype=np.float64)
    cov_r, cov_s, cov_i = covariance(zr), covariance(zs), covariance(zi)
    tc_r = temporal_covariances(zr, lags)
    tc_s = temporal_covariances(zs, lags)
    tc_i = temporal_covariances(zi, lags)
    return {
        "A_B_exact_same_multivariate_samples": exact_permutation,
        # Retain the legacy key used by the hard guard.
        "A_B_exact_same_samples_per_coordinate": exact_permutation,
        "A_B_mean_max_abs_diff": float(np.max(np.abs(real.mean(0) - shuffled.mean(0)))),
        "A_B_cov_fro_diff": 0.0 if exact_permutation else float(np.linalg.norm(cov_r - cov_s, ord="fro")),
        "A_B_covariance_identity_basis": "exact full-space consequence of identical row multiset",
        "A_C_cov_rel_fro_diff": float(np.linalg.norm(cov_r - cov_i, ord="fro") / max(np.linalg.norm(cov_r, ord="fro"), 1e-12)),
        "A_C_covariance_comparison_basis": f"fixed_random_projection_dim_{projection.shape[0]}",
        "A_B_wasserstein_flat": empirical_wasserstein_1d(real.ravel(), shuffled.ravel()),
        "A_C_wasserstein_flat": empirical_wasserstein_1d(real.ravel(), iid.ravel()),
        "A_moments": distribution_moments(real), "B_moments": distribution_moments(shuffled),
        "C_moments": distribution_moments(iid),
        "offdiag_temporal_fro_A": float(np.linalg.norm(tc_r[1:])),
        "offdiag_temporal_fro_B": float(np.linalg.norm(tc_s[1:])),
        "offdiag_temporal_fro_C": float(np.linalg.norm(tc_i[1:])),
        "temporal_covariance_basis": f"fixed_random_projection_dim_{projection.shape[0]}",
        "temporal_covariance_A": tc_r, "temporal_covariance_B": tc_s, "temporal_covariance_C": tc_i,
    }


def require_exact_ab_control(check: Mapping[str, Any]) -> None:
    """Abort on a broken A/B intervention; never silently compare wrong noise."""
    if not bool(check["A_B_exact_same_samples_per_coordinate"]):
        raise RuntimeError("Invalid A/B ablation: shuffled noise is not an exact row permutation of real noise.")
    # Reduction order can introduce machine-level roundoff despite exact rows.
    if float(check["A_B_cov_fro_diff"]) > 1e-11:
        raise RuntimeError("Invalid A/B ablation: a permutation changed same-time covariance beyond roundoff.")


def orthonormal_projection(dim: int, q: int, seed: int) -> Any:
    import numpy as np
    rng = np.random.default_rng(seed)
    qmat, _ = np.linalg.qr(rng.normal(size=(dim, q)))
    return qmat[:, :q].T.astype(np.float32)  # q x dim


def cov_spectrum(cov: Any) -> Dict[str, Any]:
    import numpy as np
    vals = np.linalg.eigvalsh(np.asarray(cov, dtype=np.float64))
    vals = np.clip(vals, 0.0, None)[::-1]
    return {"eigenvalues_desc": vals, "trace": float(vals.sum()),
            "effective_rank": float((vals.sum() ** 2) / max(float((vals ** 2).sum()), 1e-12))}


def relaxation_times_from_A(A: Any) -> Dict[str, Any]:
    import numpy as np
    eig = np.linalg.eigvals(A)
    mag = np.clip(np.abs(eig), 1e-12, 1 - 1e-12)
    return {"eigenvalues": eig, "relaxation_times": -1.0 / np.log(mag)}


def simulate_linear(A: Any, noise: Any) -> Any:
    import numpy as np
    x = np.zeros((len(noise) + 1, A.shape[0]), dtype=np.float64)
    for t, xi in enumerate(noise):
        x[t + 1] = A @ x[t] + xi
    return x


def theoretical_linear_covariance(A: Any, temporal_cov: Any, horizon: int) -> Any:
    """C_H=sum_{s,t} A^(H-1-s) K_st A^(H-1-t)^T for stationary K by lag."""
    import numpy as np
    d = A.shape[0]
    # P[s] = A^(H-1-s). Summing all pairs one-by-one is a Python bottleneck;
    # group pairs by lag and contract each lag in compiled NumPy instead.
    P = np.stack([np.linalg.matrix_power(A, horizon - 1 - s) for s in range(horizon)])
    out = np.zeros((d, d), dtype=np.float64)
    for lag in range(horizon):
        left = P[lag:]
        right = P[:horizon-lag]
        forward = np.einsum("aij,jk,alk->il", left, temporal_cov[lag], right, optimize=True)
        out += forward if lag == 0 else forward + forward.T
    return out


