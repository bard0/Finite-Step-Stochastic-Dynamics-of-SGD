    import numpy as np
    A = np.diag(np.array([0.95, 0.8, 0.5, 0.2], dtype=np.float64))
    rng = np.random.default_rng(CFG.global_seed)
    total = CFG.linear_horizon + CFG.noise_lags + 40
    report: Dict[str, Any] = {"A": A, "conditions": {}}
    print(f"[M7.1] start: {len(CFG.rho_values)} rho conditions, {CFG.linear_replicates} replicates each", flush=True)
    for rho in CFG.rho_values:
        started = time.perf_counter()
