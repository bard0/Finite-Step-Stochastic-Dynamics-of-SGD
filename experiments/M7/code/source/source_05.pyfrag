def edmd_diagnostics(observables: Any, ridge: float = 1e-6) -> Dict[str, Any]:
    import numpy as np
    X = np.asarray(observables[:-1], dtype=np.float64); Y = np.asarray(observables[1:], dtype=np.float64)
    # K maps feature(t) to feature(t+1), stable pseudo-inverse with fixed ridge.
    K = np.linalg.solve(X.T @ X + ridge * np.eye(X.shape[1]), X.T @ Y)
    eig = np.linalg.eigvals(K)
    mag = np.clip(np.abs(eig), 1e-12, 1 - 1e-12)
    return {"koopman_eigenvalues": eig, "decay_rates": -np.log(mag), "ridge": ridge}


def projected_observables(path: Mapping[str, Any], R: Any) -> Any:
    import numpy as np
    theta = path["theta"][:-1].numpy(); dtheta = theta - theta[0]
    proj = dtheta @ R.T
    base = np.column_stack([path["parameter_norm"][:-1].numpy(), path["loss"].numpy(), proj])
    # Fixed nonlinear dictionary; not used in confirmation/verdict logic.
    return np.column_stack([base, base[:, :min(6, base.shape[1])] ** 2])


def neural_metrics(paths: Mapping[str, Sequence[Mapping[str, Any]]], R: Any) -> Dict[str, Any]:
    import numpy as np
    out: Dict[str, Any] = {}
    for h in CFG.horizons:
        item: Dict[str, Any] = {}
        for mode, seed_paths in paths.items():
            endpoint = np.stack([p["theta"][h].numpy() - p["theta"][0].numpy() for p in seed_paths])
            p_endpoint = endpoint @ R.T
            item[mode] = {"parameter_diagonal_covariance": endpoint.var(axis=0),
                          "parameter_trace_covariance": float(endpoint.var(axis=0).sum()),
                          "random_projection_covariance": covariance(p_endpoint),
                          "observable_covariance": covariance(np.stack([[float(p["parameter_norm"][h]), float(p["loss"][h-1]), float(p["hessian_trace"][h])] for p in seed_paths])),
                          "n_seed_endpoints": len(endpoint)}
            if CFG.store_full_parameter_covariance:
                item[mode]["full_parameter_covariance"] = covariance(endpoint).astype(np.float32)
        out[str(h)] = item
    return out


def projected_hessian_response(record: Mapping[str, Any], R: Any, device: Any) -> Any:
    """Fixed projected Hessian at theta_0 for a transparent local response model."""
    import numpy as np
    import torch
    model = make_model(0, device); assign_parameters(model, record["theta0"].to(device))
    mse = torch.nn.MSELoss(); g = gradient_vector(mse(model(record["x"]), record["y"]), model, create_graph=True)
    directions = torch.as_tensor(R, device=device, dtype=g.dtype)
    q = directions.shape[0]
    hv_parts = torch.autograd.grad(g, tuple(model.parameters()), grad_outputs=directions,
                                   is_grads_batched=True, retain_graph=False)
    hv = torch.cat([part.reshape(q, -1) for part in hv_parts], dim=1)
    return (directions @ hv.T).detach().cpu().numpy()


def linear_response_prediction(record: Mapping[str, Any], R: Any, lr: float, device: Any) -> Dict[str, Any]:
    """Projected finite-horizon prediction: full lag-K versus K_0-only.

    The basis is fixed before outcomes.  Hessian probes are evaluated on the
    A reference path only, which prevents outcome-adaptive model selection.
    """
    import numpy as np
    noise = record["noise"].numpy(); z = noise @ R.T
    K = temporal_covariances(z, max(CFG.horizons) - 1)
    H_proj = projected_hessian_response(record, R, device)
    response = np.eye(R.shape[0]) - lr * H_proj
    predictions: Dict[str, Any] = {}
    for h in CFG.horizons:
        marginal_K = np.zeros_like(K); marginal_K[0] = K[0]
        predictions[str(h)] = {"full_temporal_K_prediction": (lr * lr) * theoretical_linear_covariance(response, K, h),
                               "marginal_K0_prediction": (lr * lr) * theoretical_linear_covariance(response, marginal_K, h),
                               "basis": "fixed_random_projection", "local_response": "projected_Hessian_at_theta0"}
    return {"temporal_covariance": K, "projected_hessian": H_proj, "response": response,
            "predictions": predictions, "warning": "Local projected linear-response diagnostic; not a complete nonlinear-SGD theory claim."}


def neural_seed_required_files(tag: str, seed: int) -> List[str]:
    base = f"results/M7_2_neural_SGD/{tag}"
    return [f"{base}/seed_{seed}_{mode}_trajectory.npz" for mode in ("real", "shuffle", "iid")] + [
        f"{base}/seed_{seed}_reference_sgd.npz"]


def load_neural_seed(store: ArtifactStore, tag: str, seed: int, device: Any) -> Tuple[Dict[str, Any], Dict[str, Dict[str, Any]], Dict[str, Any]]:
    """Restore one completed seed only after its full artifact set was hash-validated."""
    import numpy as np
    import torch
    base = store.run_dir / "results" / "M7_2_neural_SGD" / tag
    paths: Dict[str, Dict[str, Any]] = {}
    noises: Dict[str, Any] = {}
    for mode in ("real", "shuffle", "iid"):
        with np.load(base / f"seed_{seed}_{mode}_trajectory.npz", allow_pickle=False) as data:
            horizons = data["hessian_horizons"].astype(int).tolist()
            traces = data["hessian_trace"].astype(float).tolist()
            paths[mode] = {"theta": torch.from_numpy(data["theta"].copy()),
                           "full_gradient": torch.from_numpy(data["full_gradient"].copy()),
                           "loss": torch.from_numpy(data["loss"].copy()),
                           "parameter_norm": torch.from_numpy(data["parameter_norm"].copy()),
                           "hessian_trace": dict(zip(horizons, traces))}
            noises[mode] = data["noise"].copy()
    with np.load(base / f"seed_{seed}_reference_sgd.npz", allow_pickle=False) as data:
        theta0 = torch.from_numpy(data["theta"][0].copy()).to(device)
        reference_noise = torch.from_numpy(data["noise"].copy())
    x, y = make_dataset(seed + 17, device)
    record = {"x": x, "y": y, "theta0": theta0, "noise": reference_noise,
              "noise_device": reference_noise.to(device, non_blocking=True)}
    projection = orthonormal_projection(reference_noise.shape[1], CFG.projection_dim, CFG.global_seed)
    check = neural_ablation_checks(noises["real"], noises["shuffle"], noises["iid"], projection, CFG.noise_lags)
    require_exact_ab_control(check)
    return record, paths, {k: v for k, v in check.items() if not k.startswith("temporal_covariance")}


def run_m72(store: ArtifactStore) -> Dict[str, Any]:
    import numpy as np
    import torch
    torch.set_num_threads(CFG.max_torch_threads)
    device = choose_device()
    if device.type == "cuda":
        torch.set_float32_matmul_precision("high")
        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cudnn.allow_tf32 = True
    device_name = torch.cuda.get_device_name(0) if device.type == "cuda" else "CPU"
    store.write_json("configs/runtime.json", {"device": str(device), "device_name": device_name,
        "cuda": torch.cuda.is_available(), "torch": torch.__version__,
        "tf32": bool(device.type == "cuda")}, "runtime")
    print(f"[M7.2] start on {device_name}; {len(CFG.learning_rates)*len(CFG.batch_sizes)} conditions x {len(CFG.seeds)} seeds", flush=True)
    if device.type != "cuda":
        print("[M7.2] WARNING: CUDA is unavailable; this run is not using the L4.", flush=True)
    all_report: Dict[str, Any] = {"device": str(device), "conditions": {}}
    for lr in CFG.learning_rates:
        for batch in CFG.batch_sizes:
            tag = f"lr_{lr:.4f}_batch_{batch}"
            condition_started = time.perf_counter()
            print(f"[M7.2] condition {tag}", flush=True)
            condition_required = [f"results/M7_2_neural_SGD/{tag}/metrics.json",
                                  f"results/M7_2_neural_SGD/{tag}/fixed_projection.npy"]
            every_seed_valid = all(store.checkpoint_valid(f"m72_{tag}_seed_{seed}", neural_seed_required_files(tag, seed))
                                   for seed in CFG.seeds)
            condition_checkpoint_valid = every_seed_valid and store.checkpoint_valid(f"m72_{tag}", condition_required)
            existing_metrics = store.read_json(condition_required[0]) if condition_checkpoint_valid else {}
            if condition_checkpoint_valid and existing_metrics.get("diagnostic_schema") == "neural_projection_v2":
                print(f"[M7.2] condition {tag}: restored from validated checkpoint", flush=True)
                all_report["conditions"][tag] = existing_metrics
                continue
            if condition_checkpoint_valid:
                print(f"[M7.2] condition {tag}: seed artifacts valid; rebuilding stale aggregate diagnostic schema", flush=True)
            per_mode: Dict[str, List[Mapping[str, Any]]] = {"real": [], "shuffle": [], "iid": []}
            checks: List[Dict[str, Any]] = []
            records: List[Mapping[str, Any]] = []
            R = None
            for seed in CFG.seeds:
                seed_started = time.perf_counter()
                seed_required = neural_seed_required_files(tag, seed)
                if store.checkpoint_valid(f"m72_{tag}_seed_{seed}", seed_required):
                    print(f"  [seed {seed}] restoring hash-validated artifacts", flush=True)
                    record, restored_paths, restored_check = load_neural_seed(store, tag, seed, device)
                    records.append(record); checks.append(restored_check)
                    for mode in per_mode:
                        per_mode[mode].append(restored_paths[mode])
                    if R is None:
                        R = orthonormal_projection(record["noise"].shape[1], CFG.projection_dim, CFG.global_seed)
                    print(f"  [seed {seed}] restored in {time.perf_counter()-seed_started:.1f}s", flush=True)
                    continue
                print(f"  [seed {seed}] recording reference SGD", flush=True)
                record = reference_sgd_record(seed, batch, lr, device)
                records.append(record)
                p = record["noise"].shape[1]
                if R is None: R = orthonormal_projection(p, CFG.projection_dim, CFG.global_seed)
                rng = np.random.default_rng(seed + 8181)
                real_cpu = record["noise"]
                permutation = rng.permutation(len(real_cpu))
                shuffled_cpu = real_cpu[permutation]
                iid_device = gaussian_iid_surrogate(record["noise_device"], seed + 9191, device)
                iid_cpu = iid_device.cpu()
                check = neural_ablation_checks(real_cpu.numpy(), shuffled_cpu.numpy(), iid_cpu.numpy(), R, CFG.noise_lags)
                require_exact_ab_control(check)
                checks.append({k: v for k, v in check.items() if not k.startswith("temporal_covariance")})
                # A is the genuine recorded path. Only B/C require new full-gradient replays.
                real_device = record["noise_device"]
                shuffled_device = real_device[torch.as_tensor(permutation, device=device)]
                mode_inputs = (("real", real_device, real_cpu), ("shuffle", shuffled_device, shuffled_cpu),
                               ("iid", iid_device, iid_cpu))
                for mode, noise_device, noise_cpu in mode_inputs:
                    print(f"  [seed {seed}] mode={mode}: {'reuse reference' if mode == 'real' else 'counterfactual replay'}", flush=True)
