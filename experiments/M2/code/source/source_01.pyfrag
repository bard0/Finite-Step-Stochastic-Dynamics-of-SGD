# ============================================================================
# 1. Atomic checkpoints, Drive mirroring, and RNG labels.
# ============================================================================
class ProtocolStop(RuntimeError): pass
def utc(): return datetime.now(timezone.utc).isoformat()
def log(x): print(f"[{utc()}] {x}", flush=True)
def die(x): raise ProtocolStop(x)
def seed_of(*parts):
    text="|".join(map(str,(MASTER_SEED,PROTOCOL_VERSION,RUN_MODE)+parts))
    return int(hashlib.sha256(text.encode()).hexdigest()[:16],16)%(2**63-1)
def set_seed(s):
    np.random.seed(s%(2**32-1));torch.manual_seed(s)
    if torch.cuda.is_available(): torch.cuda.manual_seed_all(s)
def jdefault(x):
    if isinstance(x,Path): return str(x)
    if isinstance(x,np.ndarray): return x.tolist()
    if isinstance(x,(np.integer,)): return int(x)
    if isinstance(x,(np.floating,)): return float(x)
    if isinstance(x,(np.bool_,)): return bool(x)
    raise TypeError(type(x))
def sha256(p):
    h=hashlib.sha256()
    with open(p,"rb") as f:
        for b in iter(lambda:f.read(1<<20),b""): h.update(b)
    return h.hexdigest()
def atomic_text(p,s):
    p=Path(p);p.parent.mkdir(parents=True,exist_ok=True);q=p.with_name(p.name+".tmp")
    with open(q,"w",encoding="utf8") as f: f.write(s);f.flush();os.fsync(f.fileno())
    os.replace(q,p)
def atomic_json(p,x): atomic_text(p,json.dumps(x,indent=2,ensure_ascii=False,default=jdefault))
def atomic_npz(p,**x):
    p=Path(p);p.parent.mkdir(parents=True,exist_ok=True);q=p.with_name(p.stem+".tmp.npz")
    np.savez_compressed(q,**x)
    with open(q,"rb") as f: os.fsync(f.fileno())
    os.replace(q,p)
def complete_path(p): return Path(str(p)+".completion.json")
def save_complete_npz(p,**x):
    atomic_npz(p,**x);atomic_json(complete_path(p),{"sha256":sha256(p),"completed_utc":utc()})
def valid_complete(p):
    try: return Path(p).exists() and complete_path(p).exists() and json.loads(complete_path(p).read_text())["sha256"]==sha256(p)
    except Exception: return False
def atomic_copy(a,b):
    a,b=Path(a),Path(b);b.parent.mkdir(parents=True,exist_ok=True);q=b.with_name(b.name+".tmp")
    shutil.copy2(a,q)
    with open(q,"rb") as f: os.fsync(f.fileno())
    os.replace(q,b)
OUT=OUTD=FIG=None
def mirror_file(p):
    p=Path(p)
    if OUT is None or OUTD is None or not p.exists(): return
    q=OUTD/p.relative_to(OUT)
    if not q.exists() or sha256(p)!=sha256(q): atomic_copy(p,q)
def mirror_complete(p):
    mirror_file(p)
    if complete_path(p).exists(): mirror_file(complete_path(p))
def mirror_tree():
    for p in sorted(OUT.rglob("*")):
        if p.is_file(): mirror_file(p)
def ft(x): return str(float(x)).replace(".","p")
def state_tag(s,f): return f"seed{int(s)}_fraction{ft(f)}"
def path_tag(s,f,e): return f"{state_tag(s,f)}_eta{ft(e)}"
def cond_tag(s,f,e,b): return f"{path_tag(s,f,e)}_B{int(b)}"

# ============================================================================
# 2. Exact immutable M1 model family and differential primitives.
# ============================================================================
class TinyCNN(nn.Module):
    def __init__(self):
        super().__init__()
        self.f=nn.Sequential(nn.Conv2d(3,8,3,padding=1),nn.Tanh(),nn.AvgPool2d(2),nn.Conv2d(8,12,3,padding=1),nn.Tanh(),nn.AdaptiveAvgPool2d(1))
        self.h=nn.Linear(12,10)
    def forward(self,x): return self.h(self.f(x).flatten(1))
def new_model(dtype=DTYPE): return TinyCNN().to(DEVICE,dtype=dtype)
