# ============================================================================
# 1. Infrastructure: deterministic seeds, atomic checkpoints, Drive mirroring.
# ============================================================================
class ProtocolStop(RuntimeError):
    pass

def utc():
    return datetime.now(timezone.utc).isoformat()

def log(message):
    print(f"[{utc()}] {message}", flush=True)

def die(message):
    raise ProtocolStop(message)

def seed_of(*parts):
    text = "|".join(map(str, (MASTER_SEED, PROTOCOL_VERSION, RUN_MODE) + parts))
    return int(hashlib.sha256(text.encode("utf-8")).hexdigest()[:16], 16) % (2**63 - 1)

def set_seed(seed):
    np.random.seed(seed % (2**32 - 1))
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)

def json_default(x):
    if isinstance(x, Path): return str(x)
    if isinstance(x, np.ndarray): return x.tolist()
    if isinstance(x, (np.integer,)): return int(x)
    if isinstance(x, (np.floating,)): return float(x)
    if isinstance(x, (np.bool_,)): return bool(x)
    raise TypeError(f"Cannot JSON encode {type(x)}")

def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()

def atomic_text(path, text):
    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, path)

def atomic_json(path, value):
    atomic_text(path, json.dumps(value, indent=2, ensure_ascii=False, default=json_default))

def atomic_npz(path, **arrays):
    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.stem + ".tmp.npz")
    np.savez_compressed(tmp, **arrays)
    with open(tmp, "rb") as f: os.fsync(f.fileno())
    os.replace(tmp, path)

def completion_path(path):
    return Path(str(path) + ".completion.json")

def save_complete_npz(path, **arrays):
    atomic_npz(path, **arrays)
    atomic_json(completion_path(path), {"sha256": sha256(path), "completed_utc": utc()})

def valid_complete(path):
    path = Path(path); marker = completion_path(path)
    try:
        return path.exists() and marker.exists() and json.loads(marker.read_text())["sha256"] == sha256(path)
    except Exception:
        return False

def atomic_copy(src, dst):
    src, dst = Path(src), Path(dst); dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_name(dst.name + ".tmp")
    shutil.copy2(src, tmp)
    with open(tmp, "rb") as f: os.fsync(f.fileno())
    os.replace(tmp, dst)

OUT = None
OUT_DRIVE = None

def mirror_file(local_path):
    """Copy one completed local artifact to Drive atomically."""
    local_path = Path(local_path)
    if OUT is None or OUT_DRIVE is None or not local_path.exists(): return
    remote = OUT_DRIVE / local_path.relative_to(OUT)
    if not remote.exists() or sha256(local_path) != sha256(remote):
        atomic_copy(local_path, remote)

def mirror_complete(path):
    mirror_file(path)
    marker = completion_path(path)
    if marker.exists(): mirror_file(marker)

def mirror_tree():
    for p in sorted(OUT.rglob("*")):
        if p.is_file(): mirror_file(p)

def frac_tag(x): return str(float(x)).replace(".", "p")
def eta_tag(x): return str(float(x)).replace(".", "p")
def state_tag(seed, fraction): return f"seed{seed}_fraction{frac_tag(fraction)}"
def path_tag(seed, fraction, eta): return f"{state_tag(seed, fraction)}_eta{eta_tag(eta)}"
def raw_tag(seed, fraction, eta, batch, pool):
    return f"{path_tag(seed, fraction, eta)}_B{int(batch)}_{pool}.npz"

def tensor_rng_indices(rng, n, batch):
    return torch.tensor(rng.integers(0, n, size=int(batch)), device=DEVICE, dtype=torch.long)

